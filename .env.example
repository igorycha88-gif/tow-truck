# ── База данных (PostgreSQL) ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tow_truck?schema=public"

# ── Redis (rate-limit, кэш) ──
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# ── Telegram (уведомления о заявках) ──
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ── Yandex Maps (карта зоны обслуживания) ──
YANDEX_MAPS_API_KEY=""

# ── Yandex.Метрика (публичная, NEXT_PUBLIC_*) ──
NEXT_PUBLIC_METRIKA_ID=""

# ── Публичные настройки сайта ──
# Prod: https://эвакуация.online (см. deploy/nginx/)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Эвакуация Москва и МО"
NEXT_PUBLIC_PHONE="+7 (901) 705-45-40"
# Публичный email необязателен; оставьте пустым, чтобы не показывать почту на сайте.
NEXT_PUBLIC_EMAIL=""
NEXT_PUBLIC_WHATSAPP=""
NEXT_PUBLIC_TELEGRAM=""

# ── Email-резерв (Nodemailer) ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
NOTIFY_EMAIL="boronind1m@yandex.ru"

# ── Приложение ──
NODE_ENV="development"
PORT="3000"
LOG_LEVEL="info"

# ── Безопасность / антиспам ──
RATE_LIMIT_ORDERS_PER_HOUR="3"
