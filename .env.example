# ── База данных (PostgreSQL) ──
# Dev (docker-compose.dev.yml): внутренний URL контейнера.
# Prod (VPS): указывайте хост 127.0.0.1 и пароль POSTGRES_PASSWORD.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tow_truck?schema=public"
# Контейнер БД (prod docker-compose.yml):
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="tow_truck"

# ── Redis (rate-limit, кэш) ──
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# ── Telegram (уведомления о заявках) ──
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ── Yandex Maps (карта зоны обслуживания) ──
YANDEX_MAPS_API_KEY=""

# ── Yandex.Метрика (публичная, NEXT_PUBLIC_*) ──
NEXT_PUBLIC_METRIKA_ID=""

# ── SEO: верификация поисковиков (мета-теги) ──
# Yandex.Webmaster → Добавить сайт → Проверка прав → мета-тег.
# Скопируйте ТОЛЬКО значение content="..." (без обрамления тега).
NEXT_PUBLIC_YANDEX_VERIFICATION=""
# Google Search Console → Способы проверки → HTML-тег.
# Скопируйте ТОЛЬКО значение content="...".
NEXT_PUBLIC_GOOGLE_VERIFICATION=""

# ── SEO: координаты для LocalBusiness (schema.org GeoCoordinates) ──
# По умолчанию — центр Москвы. Замените на реальные координаты вашей базы.
NEXT_PUBLIC_LATITUDE="55.7558"
NEXT_PUBLIC_LONGITUDE="37.6173"

# ── SEO: ссылки на карточки в картах (schema.org sameAs) ──
NEXT_PUBLIC_YANDEX_MAPS_URL=""
NEXT_PUBLIC_2GIS_URL=""

# ── Публичные настройки сайта ──
# Prod: https://эвакуация.online (см. deploy/nginx/)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Эвакуация Москва и МО"
NEXT_PUBLIC_PHONE="+7 (901) 705-45-40"
# Публичный email необязателен; оставьте пустым, чтобы не показывать почту на сайте.
NEXT_PUBLIC_EMAIL=""
NEXT_PUBLIC_WHATSAPP=""
NEXT_PUBLIC_TELEGRAM=""

# ── Email-резерв (Nodemailer) ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
NOTIFY_EMAIL="boronind1m@yandex.ru"

# ── Приложение ──
NODE_ENV="development"
PORT="3000"
LOG_LEVEL="info"

# ── Безопасность / антиспам ──
RATE_LIMIT_ORDERS_PER_HOUR="3"
