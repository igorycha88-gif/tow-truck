# ─────────────────────────────────────────────────────────────────────
# Ключ доступа к /metrics/* для централизованного мониторинга
# (ЧТЗ «Централизованный мониторинг», §5.1; TASK-INF-003).
#
# ВНИМАНИЕ: это ШАБЛОН. Реальный ключ (64 hex, общий секрет с
# мониторингом VPS 130.49.129.241) в git НЕ коммитится
# (критерий приёмки №5 ЧТЗ).
#
# Установка на VPS:
#   1. Сгенерировать/получить ключ у владельца (тот же, что у мониторинга).
#   2. sudo cp monitoring-key.conf.example /etc/nginx/conf.d/monitoring-key.conf
#   3. Заменить <ЗАМЕНИТЕ_НА_РЕАЛЬНЫЙ_КЛЮЧ_64_HEX> на реальный ключ.
#   4. sudo chmod 600 /etc/nginx/conf.d/monitoring-key.conf && sudo chown root:root ...
#   5. sudo nginx -t && sudo systemctl reload nginx
# ─────────────────────────────────────────────────────────────────────

map $http_x_monitoring_key $metrics_auth {
    default 0;
    "<ЗАМЕНИТЕ_НА_РЕАЛЬНЫЙ_КЛЮЧ_64_HEX>"  1;
}
