// Архитектура БД: см. ARCHITECTURE.md §5
// Контент (услуги/цены/отзывы) хранится в src/config/, НЕ в БД (нет админки).

generator client {
  provider      = "prisma-client-js"
  // Покрываем: локальный dev (native), docker на Mac arm64 (debian slim),
  // и docker alpine (на случай смены базы). См. Prisma system requirements.
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id          String   @id @default(cuid())
  // Читаемый порядковый номер (ADR-013): PG sequence, сквозной с 1.
  // Отображаемый номер = formatOrderNumber(createdAt, number) → ГГГГММДД-N.
  number      Int      @unique @default(autoincrement())
  name        String
  phone       String
  // Блок «Адреса» (ЧТЗ_Блок_адресов_в_форме_заявки.md): откуда забрать / куда доставить.
  addressFrom String // обязательный адрес подачи (бывш. location)
  addressTo   String? // необязательный адрес доставки (null = доставка не требуется)
  serviceType String // light_vehicle, moto, commercial, offroad, accident, fuel
  status      String   @default("NEW") // NEW, CALLED, DONE, CANCELLED
  source      String   @default("website")
  ip          String?
  utm         Json?
  // 152-ФЗ: момент получения согласия на обработку ПД (кнопка отправки неактивна
  // до чекбокса, см. ЧТЗ_Неактивная_кнопка_до_согласия.md). Логируется также в pino.
  consentAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// События трекинга (бизнес-метрики, см. ADR-001, ЧТЗ_Сайт_эвакуация_online_
// Полные_Бизнес_Метрики.md, ADR-012 мониторинга): клики по телефону и по
// услугам. Уникальные IP из Order + ClickEvent дают метрику «посетители».
// click_whatsapp больше не собирается (мессенджеры не подключены,
// ЧТЗ_Уборка_метрик_заявок_WhatsApp_время_кликов.md); исторические
// строки остаются.
model ClickEvent {
  id        String   @id @default(cuid())
  ip        String?
  userAgent String?
  page      String   @default("home") // home, contacts, floating_call, header, service_page
  eventType String   @default("click_phone") // click_phone | service_click (исторически также click_whatsapp)
  service   String? // slug услуги (для service_click)
  referer   String? // источник сессии: host | (direct)
  city      String? // город по GeoLite2 (geoip-lite)
  sessionId String? // сессия вкладки (ADR-014) — связка клика с сессией для воронки
  device    String? // mobile | tablet | desktop (server-side из UA, ADR-014)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([page])
  @@index([eventType, createdAt])
}

// Трекинг визитов на сайт (ADR-002, v2 — ADR-014: полный путь клиента).
// С v2 каждая навигация пишется отдельной строкой (pageview):
// sessionId — сессия вкладки; visitorId — постоянный анонимный ID (новые/вернувшиеся);
// viewId — ключ leave-обновления dwellMs; fromPage — предыдущая страница (null = вход);
// utm_* — метки с посадочной URL; device — по UA; dwellMs — время на странице.
// referer — источник захода (host | (direct)); null = не входной визит сессии.
// city — город по GeoLite2 (geoip-lite).
model Visit {
  id          String   @id @default(cuid())
  ip          String?
  userAgent   String?
  page        String   @default("home") // slug страницы: home, politika, ...
  referer     String?
  city        String?
  sessionId   String?
  visitorId   String?
  viewId      String?  @unique
  fromPage    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  device      String?
  dwellMs     Int?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([page])
  @@index([sessionId])
  @@index([visitorId, createdAt])
}
